PORT=4100
DATABASE_URL=postgres://postgres:postgres@localhost:55440/quelron_dev
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Super-admin (platform operator, founder-only) login -- see
# src/middleware/auth.js's requireSuperAdmin. Single operator for now, no
# separate admin-user table (see docs/05-roles-controls.md).
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_JWT_SECRET=change-this-to-a-different-long-random-string

# Comma-separated list of origins allowed to call this API cross-origin.
# Leave unset for local dev through Vite's proxy.
CORS_ORIGIN=http://localhost:5173

# Set to 1 once actually deployed behind a reverse proxy.
TRUST_PROXY=

# Set to 1 to run migrations automatically on every boot (useful on a host
# with no shell access to run `npm run migrate` manually). Safe to leave off
# once migrations are already applied and you have a normal way to run them.
RUN_SETUP_ON_BOOT=
